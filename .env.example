# Discordへ接続する場合は、次の3項目を入力してください。
# シミュレーターだけを使う場合は、空欄のままで構いません。
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# Bot Rack外の送信Botなど、追加で自己ループ除外するBot User ID（カンマ区切り）
DISCORD_TX_BOT_USER_IDS=

# Phase 10 Core所有権。現在安全に起動できるのはtypescript / rust-shadowだけです。
# rust-canary / rust-productionは実Device・DiscordのAcceptance完了まで起動時に拒否されます。
# 変更は再起動後だけ反映され、配信中に自動切替しません。
ROUTER_CORE_OWNERSHIP=typescript

# 旧Rust metadata shadow設定。ROUTER_CORE_OWNERSHIP未設定時だけ後方互換として参照します。
# 新しい設定ではROUTER_CORE_OWNERSHIP=rust-shadowを使用してください。
DISCORD_RUST_SHADOW=0

# 複数Bot（受信20接続 + 送信4接続）を使う場合
# discord-bots.example.json を discord-bots.json にコピーし、各 tokenEnv で指定した変数を追加します。
# Token自体はJSONへ直接書かないでください。
DISCORD_BOT_RACK_FILE=
DISCORD_BOT_TOKEN_RX01=
DISCORD_BOT_TOKEN_RX02=
DISCORD_BOT_TOKEN_TX_GAME01=
DISCORD_BOT_TOKEN_TX_CASTER01=
DISCORD_BOT_TOKEN_TX_COMMENTARY01=
DISCORD_BOT_TOKEN_TX_IFB01=

# Tablet Control is deferred pending redesign; no dedicated listener is started.

# Exact Desktop Operator origin allowed to issue HTTP/WebSocket commands.
# Defaults to http://127.0.0.1:${PORT}; LAN mode adds this explicit origin to its allowlist.
# DBR_OPERATOR_ORIGIN=http://127.0.0.1:4173

# Main UI LAN access: opt-in, no user authentication. Never enable on a shared LAN.
# Restart required. Bot/Token/Rust/restart/Support Bundle APIs remain loopback-only.
DBR_LAN_ACCESS=0
